{
  "name": "fallback-nearest",
  "description": "Every backend is outside a tiny radius, so fallback picks the geographically nearest one.",
  "input": {
    "config": {
      "backends": [
        {
          "id": "west",
          "region": "us-west-2",
          "url": "https://west.example.com"
        },
        {
          "id": "east",
          "region": "us-east-1",
          "url": "https://east.example.com"
        }
      ],
      "policy": "balanced",
      "radius_km": 100,
      "fallback": "nearest"
    },
    "request": {
      "path": "/",
      "user_location": {
        "lat": 41.88,
        "lon": -87.63
      }
    },
    "now": "2026-09-18T20:05:00Z",
    "carbon": {
      "max_age_seconds": 300,
      "signals": [
        {
          "region": "us-east-1",
          "carbon_g_per_kwh": 400,
          "observed_at": "2026-09-18T20:01:00Z"
        },
        {
          "region": "us-west-2",
          "carbon_g_per_kwh": 100,
          "observed_at": "2026-09-18T20:01:00Z"
        }
      ]
    }
  },
  "expect": {
    "selected_backend_id": "east",
    "reason_code": "fallback-nearest",
    "fallback_used": true,
    "rejections": {
      "west": [
        "outside-radius"
      ],
      "east": [
        "outside-radius"
      ]
    }
  }
}
