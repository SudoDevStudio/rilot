{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain stable --target wasm32-unknown-unknown && npm ci",
  "buildCommand": ". \"$HOME/.cargo/env\" && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [
        { "key": "content-type", "value": "application/wasm" },
        { "key": "cache-control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
