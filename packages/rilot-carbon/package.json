{
  "name": "@rilot/carbon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generic carbon signal acquisition: pluggable providers and cache stores, one freshness policy. Used by the Cloudflare adapter and any JS host.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "pretest": "cargo build -p rilot-wasm --profile wasm --target wasm32-unknown-unknown --manifest-path ../../Cargo.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^20"
  }
}
